+// 「今日の復習」カード（11/23）。科目一覧（G003）の上に出す
+//
+// 【このファイルで何が起きているか】
+// lib/review.ts で決めた「復習する日」が今日以前の学習項目を並べ、押すとすぐ解き直せるようにする。
+// 今日の分がなければ、次の予定を1行だけ出す。単語はあるのにまだテストしていない学習項目も案内する
+import { useMemo } from "react";
+import { useApp } from "../state/app";
+import { dayWord, dueToday, reviewSchedule, untested } from "../lib/review";
+import { Mascot } from "./Mascot";
+
+const SHOW = 5; // 一度に出す数（多すぎると、やる気がなくなるので）
+
+export function ReviewCard() {
+  const { subjects, items, notes, tests, go, nav } = useApp();
+  const now = Date.now();
+  const { due, next, fresh } = useMemo(() => {
+    const due = dueToday(items, tests, now);
+    const next = due.length ? undefined : reviewSchedule(items, tests, now).find(e => e.overdue < 0);
+    return { due, next, fresh: untested(items, notes, tests) };
+  }, [items, notes, tests]); // eslint-disable-line react-hooks/exhaustive-deps -- now は日付が変わるまで同じ結果なので入れない
+  if (!due.length && !next && !fresh.length) return null;
+  const subjectName = (subjectId: string) => subjects.find(s => s.subjectId === subjectId)?.subjectName ?? "";
+  return (<section className="review" aria-labelledby="review-h">
+    <div className="row"><Mascot size={40} mood={due.length ? "cheer" : "happy"} /><h3 id="review-h">今日の復習{due.length > 0 && <span className="count">{due.length}</span>}</h3>
+      <span className="sp" /><span className="mute" title="前回の正答率と、続けて8割以上とれた回数で、次に復習する日を決めています（間隔反復）">忘れかけたころに解き直すと、覚えやすくなるよ</span></div>
+    {due.length > 0 && <ul className="rlist">{due.slice(0, SHOW).map(e => (
+      <li key={e.item.itemId}>
+        <div className="rname"><b>{e.item.itemName}</b><span className="mute">{subjectName(e.item.subjectId)}</span></div>
+        <div className="mute">前回 {Math.round(e.rate * 100)}%・{dayWord(Date.parse(e.lastAt), now)}に解いた{e.overdue > 0 && <span className="late">（{e.overdue}日遅れ）</span>}</div>
+        <span className="row"><button className="btn sm pri" onClick={() => nav({ s: "G009", subjectId: e.item.subjectId, itemId: e.item.itemId, testId: e.testId, mode: "retry" })}>解き直す</button>
+          <button className="btn sm line" onClick={() => void go({ s: "G004", subjectId: e.item.subjectId, itemId: e.item.itemId })}>ノートを見る</button></span>
+      </li>))}</ul>}
+    {due.length > SHOW && <p className="mute">ほかに {due.length - SHOW} 件あります。上から順にやっていこう。</p>}
+    {!due.length && next && <p className="mute">今日の復習はありません。次は{dayWord(next.dueDay, now)}：「{next.item.itemName}」</p>}
+    {fresh.length > 0 && <p className="mute fresh">単語テストをまだ解いていない項目：{fresh.slice(0, 3).map((i, k) => <span key={i.itemId}>{k > 0 && "、"}<button className="link" onClick={() => void go({ s: "G008", subjectId: i.subjectId, itemId: i.itemId })}>{i.itemName}</button></span>)}{fresh.length > 3 && ` ほか${fresh.length - 3}件`}</p>}
+  </section>);
+}
