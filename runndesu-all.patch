+
+/** サンプルの科目を作り、作った科目と最初の学習項目を返す。途中で失敗したらエラーの文を投げる */
+export async function createSample(studentId: string): Promise<{ subject: Subject; first: LearningItem }> {
+  const must = <T>(r: { error?: string; data?: unknown }) => { if (r.error) throw new Error(r.error); return r.data as T; };
+  const subject = must<Subject>(await controller.handleRequest("G003", "addSubject", { studentId, name: SAMPLE.subject }));
+  const made = new Map<string, LearningItem>();
+  for (const it of SAMPLE.items) {
+    const item = must<LearningItem>(await controller.handleRequest("G004", "addItem", { studentId, subjectId: subject.subjectId, name: it.name }));
+    made.set(it.name, item);
+    const words = newPart(PartType.FRAME, 24, "word"), summary = newPart(PartType.FRAME, 0, "summary");
+    words.words = it.words.map(([term, meaning]) => new Word({ wordId: newId(), partId: words.partId, term, meaning, updatedAt: words.updatedAt }));
+    words.height = 76 + it.words.length * 34; // 見出し＋1行約34px×単語の数＋「＋単語」ボタン
+    summary.text = it.summary; summary.y = words.y + words.height + 36;
+    must(await controller.handleRequest("G004", "saveNote", { studentId, itemId: item.itemId, parts: [words, summary] }));
+  }
+  for (const it of SAMPLE.items) {
+    if (!it.prereqs.length) continue;
+    must(await controller.handleRequest("G004", "setPrerequisites", { itemId: made.get(it.name)!.itemId, prereqIds: it.prereqs.map(n => made.get(n)!.itemId) }));
+  }
+  return { subject, first: made.get(SAMPLE.items[0].name)! };
+}
