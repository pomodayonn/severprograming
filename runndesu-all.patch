new file mode 100644
index 0000000..eff616b
--- /dev/null
+++ b/src/lib/review.ts
@@ -0,0 +1,91 @@
+// 復習のタイミング（11/23）
+//
+// 【このファイルで何が起きているか】
+// 「いつ復習すると覚えやすいか」を、単語テスト（意味→用語。採点があるもの）の結果から決める。
+// 人は一度覚えたことも時間がたつと忘れるので、忘れかけたころに解き直すと記憶に残りやすい（間隔反復）。
+// 決め方（だれでも同じ結果になるように、数だけで決める）
+//   1. 学習項目ごとに、単語テストの受験をすべて新しい順に並べる
+//   2. いちばん新しい回の正答率が
+//        60%未満        → 1日後
+//        60〜79%        → 2日後
+//        80%以上        → 「続けて80%以上だった回数」で 1回目 3日後・2回目 7日後・3回目 14日後・4回目以上 30日後
+//   3. 最後に解いた日 ＋ その日数 が今日以前なら「今日の復習」に出す（遅れている日数が多い順・正答率が低い順）
+// 日付はこの端末の時刻で、日の区切りは夜0時
+import type { LearningItem } from "../beans/LearningItem";
+import type { Note } from "../beans/Note";
+import type { Test } from "../beans/Test";
+import { TestType } from "../enums/TestType";
+import { attemptsOf } from "./select";
+
+/** 続けて80%以上だった回数ごとの、次の復習までの日数 */
+export const GOOD_STEPS = [3, 7, 14, 30] as const;
+const DAY = 24 * 60 * 60 * 1000;
+
+/** 1回分の結果（学習項目の、どれかの単語テストの受験） */
+export interface Take { testId: string; takenAt: string; rate: number }
+
+/** その学習項目の単語テストの受験を、新しい順に */
+export function takesOf(tests: readonly Test[], itemId: string): Take[] {
+  const out: Take[] = [];
+  for (const t of tests) {
+    if (t.itemId !== itemId || t.testType !== TestType.MEANING_TO_TERM || !t.questions.length) continue;
+    for (const a of attemptsOf(t)) out.push({ testId: t.testId, takenAt: a.takenAt, rate: a.answers.filter(x => x.correct).length / t.questions.length });
+  }
+  return out.sort((a, b) => b.takenAt.localeCompare(a.takenAt));
+}
+
+/** 次の復習までの日数（takes は新しい順） */
+export function intervalDays(takes: readonly Take[]): number {
+  const last = takes[0]; if (!last) return 0;
+  if (last.rate < 0.6) return 1;
+  if (last.rate < 0.8) return 2;
+  let streak = 0; for (const t of takes) { if (t.rate >= 0.8) streak++; else break; }
+  return GOOD_STEPS[Math.min(streak, GOOD_STEPS.length) - 1];
+}
+
+/** その時刻の日の始まり（夜0時、この端末の時刻）のミリ秒 */
+export const startOfDay = (ms: number) => { const d = new Date(ms); d.setHours(0, 0, 0, 0); return d.getTime(); };
+
+export interface ReviewEntry {
+  item: LearningItem;
+  /** いちばん新しい回の正答率 */
+  rate: number;
+  /** 最後に解いた日時 */
+  lastAt: string;
+  /** 次に復習する日（その日の0時のミリ秒） */
+  dueDay: number;
+  /** 今日から見て何日遅れているか（今日がちょうどなら0。まだ先ならマイナス） */
+  overdue: number;
+  /** 解き直すテスト（いちばん最近解いた単語テスト） */
+  testId: string;
+}
+
+/** 単語テストを1回以上解いた学習項目の、次の復習の予定（早い順） */
+export function reviewSchedule(items: readonly LearningItem[], tests: readonly Test[], nowMs: number): ReviewEntry[] {
+  const today = startOfDay(nowMs), out: ReviewEntry[] = [];
+  for (const item of items) {
+    const takes = takesOf(tests, item.itemId), last = takes[0]; if (!last) continue;
+    const dueDay = startOfDay(Date.parse(last.takenAt)) + intervalDays(takes) * DAY;
+    out.push({ item, rate: last.rate, lastAt: last.takenAt, dueDay, overdue: Math.round((today - dueDay) / DAY), testId: last.testId });
+  }
+  return out.sort((a, b) => a.dueDay - b.dueDay || a.rate - b.rate);
+}
+
+/** 今日の復習（今日以前が予定日のもの）。遅れている日数が多い順、同じなら正答率が低い順 */
+export function dueToday(items: readonly LearningItem[], tests: readonly Test[], nowMs: number): ReviewEntry[] {
+  return reviewSchedule(items, tests, nowMs).filter(e => e.overdue >= 0).sort((a, b) => b.overdue - a.overdue || a.rate - b.rate);
+}
+
+/** 単語枠に単語があるのに、まだ単語テストを1回も解いていない学習項目（作った順） */
+export function untested(items: readonly LearningItem[], notes: readonly Note[], tests: readonly Test[]): LearningItem[] {
+  return items.filter(i => {
+    const hasWords = notes.find(n => n.itemId === i.itemId)?.parts.some(p => p.frameType === "word" && p.words.some(w => w.term.trim() && w.meaning.trim()));
+    return hasWords && !takesOf(tests, i.itemId).length;
+  });
+}
+
+/** 「3日前」「今日」「明日」などの言い方（予定日・最後に解いた日の表示用） */
+export function dayWord(dayMs: number, nowMs: number): string {
+  const d = Math.round((startOfDay(dayMs) - startOfDay(nowMs)) / DAY);
+  return d === 0 ? "今日" : d === 1 ? "明日" : d === -1 ? "きのう" : d > 0 ? `${d}日後` : `${-d}日前`;
+}
