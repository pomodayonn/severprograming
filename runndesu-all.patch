+// ---------- 11/23：正答率（どれくらい覚えたか）を見る ----------
+// 採点があるのは「意味→用語」の単語テストだけなので、どれもそのテストの結果から数える
+
+/** 1回分の点数 */
+export interface ScorePoint { attemptNo: number; takenAt: string; ok: number; total: number; rate: number }
+
+/** そのテストの点数の推移（1回目から順に）。採点のないテストや、まだ解いていないテストは空 */
+export function scoreHistory(test: Test): ScorePoint[] {
+  if (test.testType !== TestType.MEANING_TO_TERM) return [];
+  const total = test.questions.length;
+  return attemptsOf(test).map(a => { const ok = a.answers.filter(x => x.correct).length; return { attemptNo: a.attemptNo, takenAt: a.takenAt, ok, total, rate: total ? ok / total : 0 }; });
+}
+
+/**
+ * 学習項目の正答率（0〜1）。その項目の単語テスト（意味→用語）それぞれの「いちばん新しい回」を合わせて数える。
+ * 例：10問中8問と5問中2問なら (8+2)/(10+5)。1回も解いていなければ null
+ */
+export function itemMastery(tests: readonly Test[], itemId: string): number | null {
+  let ok = 0, total = 0;
+  for (const t of tests) {
+    if (t.itemId !== itemId) continue;
+    const s = lastScore(t); if (!s || !s.total) continue;
+    ok += s.ok; total += s.total;
+  }
+  return total ? ok / total : null;
+}
+
+/** 正答率がこれより低い前提項目は「先に復習」と出す */
+export const WEAK_RATE = 0.6;
+
+/** その学習項目の前提項目のうち、正答率が低いもの（低い順）。解いていない前提項目は出さない */
+export function weakPrereqs(prerequisites: readonly Prerequisite[], items: readonly LearningItem[], tests: readonly Test[], itemId: string, limit = WEAK_RATE): { item: LearningItem; rate: number }[] {
+  const out: { item: LearningItem; rate: number }[] = [];
+  for (const id of prereqIdsOf(prerequisites, itemId)) {
+    const item = items.find(i => i.itemId === id), rate = itemMastery(tests, id);
+    if (item && rate !== null && rate < limit) out.push({ item, rate });
+  }
+  return out.sort((a, b) => a.rate - b.rate);
+}
+
+/** 正答率を3段階に分ける（関連図の丸の色に使う）。null は「まだ解いていない」 */
+export type MasteryLevel = "good" | "mid" | "weak" | null;
+export const masteryLevel = (rate: number | null): MasteryLevel => rate === null ? null : rate >= 0.8 ? "good" : rate >= WEAK_RATE ? "mid" : "weak";
+
+/** 学習項目IDごとの正答率（関連図に渡す形） */
+export const masteryMap = (items: readonly LearningItem[], tests: readonly Test[]): Record<string, number | null> =>
+  Object.fromEntries(items.map(i => [i.itemId, itemMastery(tests, i.itemId)]));
diff --git a/src/lib/source.ts b/src/lib/source.ts
new file mode 100644
index 0000000..e537c75
--- /dev/null
+++ b/src/lib/source.ts
@@ -0,0 +1,34 @@
+// AIの提案が「元にした内容のどこから来たか」を探す（11/23）
+//
+// 【このファイルで何が起きているか】
+// AIの提案（例：要約枠の文）と、送った内容（資料のページ・ノートの枠）を見比べて、
+// 提案の文字の並びがいちばん多く入っている所を「元になった所」として返す。
+// 比べ方：2文字ずつの組（「光合」「合成」…）に分けて、提案の組のうち何割がその所にもあるかを数える（大文字小文字・全角半角・空白は無視）。
+// AIのサーバーには手を入れず、画面の中だけで分かるので、AIが根拠を返さなくても使える
+import { norm } from "./logic";
+
+export interface SourceText { id: string; label: string; text: string }
+export interface SourceHit { id: string; label: string; score: number }
+
+/** 2文字ずつの組の集まり */
+export function grams(s: string): Set<string> {
+  const c = [...norm(s).replace(/\s+/g, "")], out = new Set<string>();
+  for (let i = 0; i + 1 < c.length; i++) out.add(c[i] + c[i + 1]);
+  return out;
+}
+
+/**
+ * 提案 content の元になった所を、よく合う順に最大 max 件返す。
+ * score は「提案の組のうち、その所にもある組の割合」（0〜1）。min より低いもの・提案が短すぎる（組が3つ未満）ときは出さない
+ */
+export function findSources(content: string, sources: readonly SourceText[], max = 2, min = 0.3): SourceHit[] {
+  const g = grams(content); if (g.size < 3) return [];
+  const hits: SourceHit[] = [];
+  for (const s of sources) {
+    const h = grams(s.text); let n = 0;
+    for (const x of g) if (h.has(x)) n++;
+    const score = n / g.size;
+    if (score >= min) hits.push({ id: s.id, label: s.label, score });
+  }
+  return hits.sort((a, b) => b.score - a.score).slice(0, max);
+}
