new file mode 100644
index 0000000..ca0f50d
--- /dev/null
+++ b/src/components/ScoreTrend.tsx
@@ -0,0 +1,27 @@
+// 正答率の推移のグラフ（11/23）
+//
+// 【このファイルで何が起きているか】
+// 単語テスト（意味→用語）を解き直すたびに、正答率がどう変わったかを折れ線で見せる。
+// 横は第1回・第2回…、縦は0〜100%。いま見ている回の点は大きく塗る。
+// 画面の読み上げ用に、全部の回の点数を aria-label にも入れる
+import type { ScorePoint } from "../lib/select";
+
+const W = 300, H = 120, L = 38, R = 12, T = 12, B = 22;
+
+export function ScoreTrend({ points, current }: { points: readonly ScorePoint[]; current?: number }) {
+  if (points.length < 2) return null; // 1回だけなら推移はないので出さない
+  const x = (i: number) => L + (points.length === 1 ? 0 : i * (W - L - R) / (points.length - 1));
+  const y = (r: number) => T + (1 - r) * (H - T - B);
+  const first = points[0].rate, last = points[points.length - 1].rate, diff = Math.round((last - first) * 100);
+  const said = points.map(p => `第${p.attemptNo}回 ${p.ok}/${p.total}問`).join("、");
+  return (<div className="trend">
+    <div className="row"><b>正答率の推移</b><span className={"mute" + (diff > 0 ? " up" : diff < 0 ? " down" : "")}>
+      {diff > 0 ? `1回目から ＋${diff}ポイント` : diff < 0 ? `1回目から ${diff}ポイント` : "1回目と同じ"}</span></div>
+    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`正答率の推移：${said}`}>
+      {[0, 0.5, 1].map(r => <g key={r}><line x1={L} x2={W - R} y1={y(r)} y2={y(r)} className="grid" /><text x={L - 6} y={y(r) + 4} textAnchor="end">{r * 100}%</text></g>)}
+      <polyline points={points.map((p, i) => `${x(i)},${y(p.rate)}`).join(" ")} className="ln" />
+      {points.map((p, i) => <g key={p.attemptNo}>
+        <circle cx={x(i)} cy={y(p.rate)} r={p.attemptNo === current ? 5.5 : 3.5} className={p.attemptNo === current ? "dot on" : "dot"}><title>{`第${p.attemptNo}回：${p.ok}/${p.total}問（${Math.round(p.rate * 100)}%）`}</title></circle>
+        <text x={x(i)} y={H - 6} textAnchor="middle">{p.attemptNo}回</text></g>)}
+    </svg></div>);
+}
