-+// キー操作の小さな決まり（11/23）
-+//
-+// 【このファイルで何が起きているか】
-+// 日本語を入力するとき、変換を確定する Enter も keydown として届く。
-+// それを「送信」「次の問題へ」の Enter と取り違えると、漢字に変換しただけで送信されてしまう。
-+// imeEnter は「変換中の Enter か」を返す。Chrome・Firefox は isComposing、Safari は keyCode 229 で分かる
-+// （React のイベントは nativeEvent に、ブラウザのイベントはそのものに入っている）
-+interface KeyLike { isComposing?: boolean; keyCode?: number; nativeEvent?: { isComposing?: boolean; keyCode?: number } }
-+
-+/** 日本語の変換を確定するための Enter（＝送信や次へ進む Enter ではない）なら true */
-+export function imeEnter(e: KeyLike): boolean {
-+  const n = e.nativeEvent ?? e;
-+  return !!(n.isComposing || e.isComposing || n.keyCode === 229 || e.keyCode === 229);
-+}
