   if ([...n].length > NAME_MAX) return `${label}は${NAME_MAX}文字までです`;
   return null;
 }
+/**
+ * 単語テストの選択肢を、全問分まとめて作る（11/23）。answers[i] が i 問目の正解。
+ * 正解1つ＋ほかの問題の答えから最大3つ。正解と同じ答え（全角半角・大文字小文字の違いだけのものも）や空の答えは混ぜない。
+ * 前は問題を開くたびに作り直していたので、前の問題に戻ると並びが変わり、同じ用語が2つあると同じ選択肢が並んでいた
+ */
+export function choicesFor(answers: readonly string[], rand: <T>(a: T[]) => T[] = shuffle): string[][] {
+  return answers.map(correct => {
+    const k = norm(correct), seen = new Set([k]), others: string[] = [];
+    for (const a of answers) { const n = norm(a); if (n && !seen.has(n)) { seen.add(n); others.push(a); } }
+    return rand([correct, ...rand(others).slice(0, 3)]);
+  });
+}
 /** 問題数を5〜20問にそろえる（数でなければ10問） */
 export const clampQuestionCount = (n: number) => Math.min(20, Math.max(5, Math.round(n) || 10));
 export const calls = (chars: number) => Math.max(1, Math.ceil(chars / SEND_LIMIT));
