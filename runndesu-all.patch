+// 単体テスト：lib/review.ts（復習のタイミング・今日の復習）
+// 時刻は決めた値を渡すので、いつ動かしても同じ結果になる
+import { describe, expect, it } from "vitest";
+import { dayWord, dueToday, intervalDays, reviewSchedule, startOfDay, takesOf, untested, type Take } from "../../src/lib/review";
+import { Test } from "../../src/beans/Test";
+import { Question } from "../../src/beans/Question";
+import { Attempt } from "../../src/beans/Attempt";
+import { Answer } from "../../src/beans/Answer";
+import { LearningItem } from "../../src/beans/LearningItem";
+import { Note } from "../../src/beans/Note";
+import { NotePart } from "../../src/beans/NotePart";
+import { Word } from "../../src/beans/Word";
+import { TestType } from "../../src/enums/TestType";
+
+const at = (y: number, m: number, d: number, h = 12) => new Date(y, m - 1, d, h).toISOString(); // この端末の時刻で
+const NOW = new Date(2026, 10, 23, 21).getTime(); // 2026/11/23 21:00
+const take = (rate: number, d = 20): Take => ({ testId: "t", takenAt: at(2026, 11, d), rate });
+
+/** 10問のテスト。runs は [日, 正解数] の受験 */
+function test(itemId: string, runs: [number, number][], type = TestType.MEANING_TO_TERM, id = `${itemId}-t`): Test {
+  const questions = Array.from({ length: 10 }, (_, i) => new Question({ questionId: `q${i}`, number: i + 1 }));
+  return new Test({ testId: id, itemId, testType: type, questions,
+    attempts: runs.map(([d, ok], k) => new Attempt({ attemptId: `${id}-a${k}`, attemptNo: k + 1, takenAt: at(2026, 11, d), answers: questions.map((q, i) => new Answer({ questionId: q.questionId, correct: i < ok })) })) });
+}
+const item = (id: string) => new LearningItem({ itemId: id, itemName: id, subjectId: "s" });
+
+describe("intervalDays：次の復習までの日数", () => {
+  it("まだ解いていなければ0", () => expect(intervalDays([])).toBe(0));
+  it("60%未満なら1日後", () => expect(intervalDays([take(0.5)])).toBe(1));
+  it("60〜79%なら2日後", () => expect(intervalDays([take(0.7)])).toBe(2));
+  it("80%以上が1回なら3日後", () => expect(intervalDays([take(0.9), take(0.4)])).toBe(3));
+  it("80%以上が2回続けば7日後", () => expect(intervalDays([take(0.8), take(1)])).toBe(7));
+  it("3回続けば14日後", () => expect(intervalDays([take(1), take(1), take(0.9)])).toBe(14));
+  it("4回以上は30日後", () => expect(intervalDays([take(1), take(1), take(1), take(1), take(1)])).toBe(30));
+});
+
+describe("takesOf：学習項目の受験（新しい順）", () => {
+  it("いくつかのテストの受験を、新しい順にまとめる", () => expect(takesOf([test("A", [[18, 5]], undefined, "t1"), test("A", [[20, 9]], undefined, "t2")], "A").map(t => [t.testId, t.rate])).toEqual([["t2", 0.9], ["t1", 0.5]]));
+  it("採点のないテストは数えない", () => expect(takesOf([test("A", [[20, 5]], TestType.TERM_TO_MEANING)], "A")).toEqual([]));
+});
+
+describe("reviewSchedule・dueToday：今日の復習", () => {
+  const items = ["A", "B", "C", "D"].map(item);
+  // A：11/20に40% → 11/21が予定（2日遅れ）／B：11/22に70% → 11/24（明日）／C：11/21に90% → 11/24／D：11/22に50% → 11/23（今日）
+  const tests = [test("A", [[20, 4]]), test("B", [[22, 7]]), test("C", [[21, 9]]), test("D", [[22, 5]])];
+  it("予定日が今日以前のものだけ、遅れている順", () => expect(dueToday(items, tests, NOW).map(e => [e.item.itemId, e.overdue])).toEqual([["A", 2], ["D", 0]]));
+  it("予定は早い順", () => expect(reviewSchedule(items, tests, NOW).map(e => e.item.itemId)).toEqual(["A", "D", "B", "C"]));
+  it("解き直すのは最後に解いたテスト", () => expect(dueToday(items, [test("A", [[19, 9]], undefined, "old"), test("A", [[20, 4]], undefined, "new")], NOW)[0].testId).toBe("new"));
+  it("夜遅くに解いても、日の区切りは夜0時", () => {
+    const late = new Test({ ...test("A", [[22, 5]]) }); late.attempts[0].takenAt = new Date(2026, 10, 22, 23, 50).toISOString();
+    expect(dueToday([item("A")], [late], NOW).map(e => e.overdue)).toEqual([0]);
+  });
+  it("解いたことがない学習項目は出さない", () => expect(dueToday(items, [], NOW)).toEqual([]));
+});
+
+describe("untested：単語があるのに、まだテストしていない学習項目", () => {
+  const word = (t: string, m: string) => new Word({ term: t, meaning: m });
+  const note = (itemId: string, words: Word[]) => new Note({ itemId, parts: [new NotePart({ frameType: "word", words })] });
+  it("単語がある・テストなし → 出す", () => expect(untested([item("A")], [note("A", [word("核", "遺伝情報")])], []).map(i => i.itemId)).toEqual(["A"]));
