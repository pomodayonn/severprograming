+// 単体テスト：TestManager の「間違えた問題だけ解き直す」（createRetryTest・wrongQuestions）
+// TestDAO の代わりに、メモリの中だけで動く小さな DAO を使う（IndexedDB を使わない）
+import { describe, expect, it } from "vitest";
+import { TestManager, wrongQuestions } from "../../src/managers/TestManager";
+import type { TestDAO } from "../../src/dao/TestDAO";
+import { Test } from "../../src/beans/Test";
+import { Question } from "../../src/beans/Question";
+import { Attempt } from "../../src/beans/Attempt";
+import { Answer } from "../../src/beans/Answer";
+import { TestType } from "../../src/enums/TestType";
+
+class MemoryDAO {
+  rows = new Map<string, Test>();
+  async insert(t: Test) { this.rows.set(t.testId, new Test({ ...t, attempts: [] })); }
+  async findById(id: string) { return this.rows.get(id) ?? null; }
+}
+const noWords = { getWords: async () => [] };
+
+function source(type = TestType.MEANING_TO_TERM) {
+  const questions = ["核", "膜", "壁", "液胞"].map((a, i) => new Question({ questionId: `q${i}`, number: i + 1, questionText: `意味${i}`, modelAnswer: a }));
+  const answers = [true, false, null, true].map((c, i) => new Answer({ questionId: `q${i}`, correct: c, studentAnswer: c ? questions[i].modelAnswer : "" }));
+  return new Test({ testId: "t1", studentId: "s", itemId: "i1", testType: type, questions, attempts: [new Attempt({ attemptId: "a1", attemptNo: 1, answers })] });
+}
+
+describe("wrongQuestions：その回で間違えた問題", () => {
+  it("不正解と未回答を、番号の順に", () => expect(wrongQuestions(source(), source().attempts[0]).map(q => q.modelAnswer)).toEqual(["膜", "壁"]));
+  it("採点のないテストは空", () => expect(wrongQuestions(source(TestType.TERM_TO_MEANING), source().attempts[0])).toEqual([]));
+});
+
+describe("createRetryTest：間違えた問題だけの新しいテスト", () => {
+  const setup = async (t = source()) => { const dao = new MemoryDAO(); dao.rows.set(t.testId, t); return { dao, m: new TestManager(dao as unknown as TestDAO, noWords) }; };
+  it("間違えた2問だけで、問題文と模範解答はそのまま", async () => {
+    const { m } = await setup(); const t = await m.createRetryTest("t1", "a1");
+    expect(t.questions.map(q => [q.number, q.questionText, q.modelAnswer])).toEqual([[1, "意味1", "膜"], [2, "意味2", "壁"]]);
+  });
+  it("新しいテストIDで、同じ学習項目・同じ種類", async () => {
+    const { m } = await setup(); const t = await m.createRetryTest("t1", "a1");
+    expect([t.testId !== "t1", t.itemId, t.testType, t.questionCount]).toEqual([true, "i1", TestType.MEANING_TO_TERM, 2]);
+  });
+  it("元のテストは変えない", async () => { const { m, dao } = await setup(); await m.createRetryTest("t1", "a1"); expect(dao.rows.get("t1")!.questions).toHaveLength(4); });
+  it("全問正解ならエラー", async () => {
+    const t = source(); t.attempts[0].answers.forEach(a => { a.correct = true; });
+    const { m } = await setup(t); let msg = ""; try { await m.createRetryTest("t1", "a1"); } catch (e) { msg = (e as Error).message; }
+    expect(msg).toBe("この回は全問正解なので、解き直す問題はありません");
+  });
+  it("採点のないテストはエラー", async () => {
+    const { m } = await setup(source(TestType.ESSAY)); let msg = ""; try { await m.createRetryTest("t1", "a1"); } catch (e) { msg = (e as Error).message; }
+    expect(msg.includes("意味→用語")).toBe(true);
+  });
+  it("ない受験IDはエラー", async () => {
+    const { m } = await setup(); let msg = ""; try { await m.createRetryTest("t1", "zzz"); } catch (e) { msg = (e as Error).message; }
+    expect(msg).toBe("受験の記録が見つかりません");
+  });
+});
