+// 画面の中に出すお知らせ（11/23）
+//
+// 【このファイルで何が起きているか】
+// ・ErrorNote：うまくいかなかったときの表示。困った顔のるん＋「何が起きたか・どうすればいいか」の文＋（あれば）次の操作のボタン。
+//   前は赤い文字が1行出るだけで、次に何をすればいいか分かりにくかった
+// ・pressable：div などを、マウスだけでなくキーボード（Tab で選んで Enter／スペース）でも押せるようにする。
+//   画面の読み上げ（スクリーンリーダー）にも「ボタン」と伝わる
+import type { KeyboardEvent } from "react";
+import { Mascot } from "./Mascot";
+
+export interface NoteAction { label: string; onClick: () => void }
+
+export function ErrorNote({ text, action }: { text: string; action?: NoteAction }) {
+  if (!text) return null;
+  return (<div className="errnote" role="alert"><Mascot size={40} mood="worried" />
+    <div><div>{text}</div>{action && <button className="btn sm line" onClick={action.onClick}>{action.label}</button>}</div></div>);
