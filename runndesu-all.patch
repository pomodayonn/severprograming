+// 単体テスト：lib/select.ts の正答率（scoreHistory・itemMastery・weakPrereqs・masteryLevel）
+// 11/23：正答率の推移のグラフ・関連図の輪・「前提を先に復習」の表示に使う
+import { describe, expect, it } from "vitest";
+import { itemMastery, masteryLevel, scoreHistory, weakPrereqs } from "../../src/lib/select";
+import { Test } from "../../src/beans/Test";
+import { Question } from "../../src/beans/Question";
+import { Attempt } from "../../src/beans/Attempt";
+import { Answer } from "../../src/beans/Answer";
+import { LearningItem } from "../../src/beans/LearningItem";
+import { Prerequisite } from "../../src/beans/Prerequisite";
+import { TestType } from "../../src/enums/TestType";
+
+/** 問題 n 問のテスト。results は回ごとの「正解した問題の数」 */
+function test(itemId: string, n: number, results: number[], type = TestType.MEANING_TO_TERM): Test {
+  const questions = Array.from({ length: n }, (_, i) => new Question({ questionId: `${itemId}-q${i}`, number: i + 1 }));
+  const attempts = results.map((ok, k) => new Attempt({ attemptId: `${itemId}-a${k}`, attemptNo: k + 1, takenAt: `2026-11-2${k}T00:00:00Z`,
+    answers: questions.map((q, i) => new Answer({ questionId: q.questionId, correct: type === TestType.MEANING_TO_TERM ? i < ok : null })) }));
+  return new Test({ testId: `${itemId}-t${n}`, itemId, testType: type, questions, attempts });
+}
+
+describe("scoreHistory：点数の推移", () => {
+  it("1回目から順に、正解数と正答率", () => expect(scoreHistory(test("A", 4, [1, 3])).map(p => [p.attemptNo, p.ok, p.rate])).toEqual([[1, 1, 0.25], [2, 3, 0.75]]));
+  it("採点のないテストは空", () => expect(scoreHistory(test("A", 4, [1], TestType.ESSAY))).toEqual([]));
+  it("まだ解いていなければ空", () => expect(scoreHistory(test("A", 4, []))).toEqual([]));
+});
+
+describe("itemMastery：学習項目の正答率", () => {
+  it("テストごとのいちばん新しい回を合わせる", () => expect(itemMastery([test("A", 10, [2, 8]), test("A", 5, [2])], "A")).toBe(10 / 15));
+  it("ほかの学習項目のテストは数えない", () => expect(itemMastery([test("A", 4, [4]), test("B", 4, [0])], "A")).toBe(1));
+  it("解いていなければ null", () => expect(itemMastery([test("A", 4, [])], "A")).toBeNull());
+  it("記述テストだけなら null", () => expect(itemMastery([test("A", 4, [1], TestType.ESSAY)], "A")).toBeNull());
+});
+
+describe("weakPrereqs：先に復習したほうがよい前提項目", () => {
+  const items = ["A", "B", "C", "D"].map(id => new LearningItem({ itemId: id, itemName: id }));
+  const pre = [new Prerequisite({ itemId: "D", prereqItemId: "A" }), new Prerequisite({ itemId: "D", prereqItemId: "B" }), new Prerequisite({ itemId: "D", prereqItemId: "C" })];
+  const tests = [test("A", 10, [3]), test("B", 10, [9]), test("C", 10, [5])];
+  it("正答率が60%より低い前提だけを、低い順に", () => expect(weakPrereqs(pre, items, tests, "D").map(w => w.item.itemId)).toEqual(["A", "C"]));
+  it("前提がなければ空", () => expect(weakPrereqs(pre, items, tests, "A")).toEqual([]));
+  it("解いていない前提は出さない", () => expect(weakPrereqs(pre, items, [test("B", 10, [1])], "D").map(w => w.item.itemId)).toEqual(["B"]));
