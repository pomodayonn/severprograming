+// 単体テスト：lib/logic.ts の choicesFor（単語テストの選択肢）
+// 11/23：同じ答えの単語が2つあると同じ選択肢が並ぶ・前の問題に戻ると並びが変わる、のバグの再発防止
+import { describe, expect, it } from "vitest";
+import { choicesFor } from "../../src/lib/logic";
+
+const keep = <T>(a: T[]) => [...a]; // 並べかえない（結果を確かめやすくする）
+
+describe("choicesFor：単語テストの選択肢", () => {
+  it("正解を必ず1つ入れる", () => {
+    const c = choicesFor(["核", "細胞膜", "細胞壁", "葉緑体", "液胞"]);
+    c.forEach((cs, i) => expect(cs.includes(["核", "細胞膜", "細胞壁", "葉緑体", "液胞"][i])).toBe(true));
+  });
+  it("選択肢は最大4つ", () => expect(choicesFor(["a", "b", "c", "d", "e", "f"])[0]).toHaveLength(4));
+  it("同じ答えが2つあっても、同じ選択肢を並べない", () => {
+    const c = choicesFor(["酸素", "酸素", "水", "光"], keep);
+    expect(c[0]).toEqual(["酸素", "水", "光"]);
+  });
+  it("全角半角・大文字小文字だけ違う答えも同じとみなす", () => expect(choicesFor(["ATP", "ａｔｐ", "DNA"], keep)[0]).toEqual(["ATP", "DNA"]));
+  it("空の答えは選択肢にしない", () => expect(choicesFor(["核", "", "  ", "膜"], keep)[0]).toEqual(["核", "膜"]));
+  it("問題が1つなら選択肢は正解だけ", () => expect(choicesFor(["核"], keep)).toEqual([["核"]]));
+});
