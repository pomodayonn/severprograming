//絶対に秘密の値は書かないでね
# このファイルを .env という名前でコピーして値を入れる（.env は GitHub に上げない）
# 両方とも空のままなら、お試しログイン＋仮のAIで画面だけ動く

# Neon の管理画面 > Auth で表示される URL（例：https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth）
VITE_NEON_AUTH_URL=

# Render のサーバーの URL（例：https://runndesu-api.onrender.com）。末尾の / はいらない
VITE_API_URL=